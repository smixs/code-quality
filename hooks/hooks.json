{
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bun ${CLAUDE_PLUGIN_ROOT}/scripts/quality.ts agent-stop", "timeout": 300, "statusMessage": "Checking code quality" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "bun ${CLAUDE_PLUGIN_ROOT}/scripts/quality.ts guard-bash", "timeout": 30, "statusMessage": "Checking git hook bypass" } ] }
    ]
  }
}
