#!/bin/sh
# code-quality pre-push: installed per repo by `quality.ts install-hooks <repo>` (core.hooksPath).
# Both the gate and the repo's own pre-push (Git LFS uploads objects here) read the pushed refs on
# stdin, so it is kept in a file and fed to each.
here=$(dirname "$0")
refs=$(mktemp) || exit 1
trap 'rm -f "$refs"' EXIT
cat > "$refs"
# The newest plugin copy invoked on this machine (hooks.ts updatePluginRoot); the last one if it is gone.
root=$(cat "$here/../hooks-root" 2>/dev/null)
[ -f "$root/scripts/quality.ts" ] || root=$(cat "$here/../root") || exit 2
bun "$root/scripts/quality.ts" hook pre-push --repo "$(git rev-parse --show-toplevel)" < "$refs" || exit $?
"$here/_chain" pre-push "$@" < "$refs"
